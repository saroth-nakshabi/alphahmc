# AlphaHMC (alphahmc.com), moved from cPanel 2026-10-19. Proxied through Cloudflare.
map $arg_v $alphahmc_asset_cache {
    ""      "public, max-age=3600";
    default "public, max-age=31536000, immutable";
}

# Images, fonts and video: 1 year for uploads (unique file names) and the front* asset folders
# (2026-10-21, SEO agent); other static files 30 days. $uri is after the /public/ strip below.
map $uri $alphahmc_static_cache {
    ~^/(uploads|front[^/]*)/  "public, max-age=31536000, immutable";
    default                   "public, max-age=2592000";
}

# WebP twins (page speed step 6, 2026-10-23): Img::thumb() writes uploads/cache/<hash>.webp next to
# <hash>.jpg/.png; browsers that accept WebP get it at the same URL (see the uploads/cache location).
map $http_accept $alphahmc_webp_suffix {
    default        "";
    "~*image/webp" ".webp";
}

# Redirect hosts: drop a trailing slash in the same hop as the www/https redirect (was two hops).
map $request_uri $alphahmc_canonical_uri {
    "~^(?<cpath>/[^?]*[^/?])/+(?<cqs>\?.*)?$"  $cpath$cqs;
    default                                    $request_uri;
}

# /index.php/<path> served a duplicate 200 page (indexed by Google): 301 to /<path> in one hop,
# trailing slash dropped, query kept. Keyed on $request_uri, so Laravel's internal
# rewrites to /index.php are never affected.
map $request_uri $alphahmc_indexphp_target {
    "~^/index\.php/*(?<ipq>\?.*)?$"                     /$ipq;
    "~^/index\.php(?<ipp>/[^?]*[^/?])/*(?<ipq2>\?.*)?$"  $ipp$ipq2;
    default                                             "";
}

server {
    listen 443 ssl http2;
    server_name alphahmc.com;
    root /var/www/alphahmc/current/public;
    index index.php;
    charset utf-8;

    if ($alphahmc_indexphp_target) {
        return 301 https://alphahmc.com$alphahmc_indexphp_target;
    }

    # Old URLs brief (22 Oct 2026), answered before the trailing-slash rewrite and the .php
    # handler so each is one hop: /careers/ with any query, and the old programs .php page.
    if ($request_uri ~ "^/careers/(\?.*)?$") {
        return 301 https://alphahmc.com/service-category/healthcare-professional-resourcing;
    }
    if ($request_uri ~ "^/professional-development-programs\.php(\?.*)?$") {
        return 301 https://alphahmc.com/service-category/training-education$1;
    }

    # Visitors arrive via Cloudflare: restore their real IP for rate limits and reCAPTCHA.
    include snippets/cloudflare-realip.conf;

    # Views call asset('public/...') expecting a project-root docroot (cPanel
    # setup). Docroot here is public/ itself, so strip the leading /public/.
    location ^~ /public/ {
        rewrite ^/public/(.*)$ /$1 last;
    }

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/alphahmc/current/public;
        try_files $uri =404;
    }

    # Mirror the Apache rule: drop trailing slashes on non-directories.
    if (!-d $request_filename) {
        rewrite ^/(.+)/$ /$1 permanent;
    }

    location ~* \.(?:css|js)$ {
        try_files $uri =404;
        add_header Cache-Control $alphahmc_asset_cache;
        access_log off;
    }
    # Resized images: serve the WebP twin when the browser accepts WebP and the twin exists, else the
    # jpg/png itself. Vary: Accept keeps caches from mixing the two. Must stay above the generic image block.
    location ~* ^/uploads/cache/(?<alphahmc_img>[a-f0-9]{32})\.(?:jpe?g|png)$ {
        add_header Vary Accept;
        add_header Cache-Control $alphahmc_static_cache;
        try_files /uploads/cache/$alphahmc_img$alphahmc_webp_suffix $uri =404;
        access_log off;
    }
    location ~* \.(?:woff2?|ttf|otf|eot|svg|png|jpe?g|gif|webp|avif|ico|mp4|webm|pdf)$ {
        try_files $uri /index.php?$query_string;
        add_header Cache-Control $alphahmc_static_cache;
        access_log off;
    }

    # robots.txt is generated by Laravel (public/.htaccess routes it to index.php).
    location = /robots.txt { rewrite ^ /index.php last; }

    location / {
        try_files $uri /index.php?$query_string;
    }

    error_page 404 /index.php;

    location ~ \.php$ {
        try_files $uri =404;
        fastcgi_pass unix:/run/php/alphahmc.sock;
        fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
        include fastcgi_params;
        fastcgi_read_timeout 300;
    }

    location ~ /\.(?!well-known).* {
        deny all;
    }

    client_max_body_size 256M;

    ssl_certificate /etc/letsencrypt/live/alphahmc.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/alphahmc.com/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
}


# www consolidates onto the apex (301 keeps SEO signals).
server {
    listen 443 ssl http2;
    server_name www.alphahmc.com;
    include snippets/cloudflare-realip.conf;
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/alphahmc/current/public;
        try_files $uri =404;
    }
    location / { return 301 https://alphahmc.com$alphahmc_canonical_uri; }
    ssl_certificate /etc/letsencrypt/live/alphahmc.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/alphahmc.com/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
}

server {
    listen 80;
    server_name alphahmc.com www.alphahmc.com;
    include snippets/cloudflare-realip.conf;
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/alphahmc/current/public;
        try_files $uri =404;
    }
    location / { return 301 https://alphahmc.com$alphahmc_canonical_uri; }
}
